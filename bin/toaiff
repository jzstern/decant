#!/usr/bin/env zsh
#
# toaiff — convert lossless audio to AIFF without quality reduction.
#
# Works on a single file or a folder (recursing into all subfolders).
# Lossy and non-audio files are left untouched. Each converted original
# is moved to the Trash once its .aiff is written successfully.
#
# Usage:
#   toaiff [--notify] PATH [PATH ...]

emulate -L zsh
setopt pipefail extended_glob

# GUI-launched processes (Finder Quick Action / Automator) inherit a minimal
# PATH that omits Homebrew, so ffmpeg/ffprobe/brew would be invisible. Make the
# script self-sufficient by adding the standard Homebrew bin directories.
path=(/opt/homebrew/bin /usr/local/bin $path)

NOTIFY=0
if [[ "${1:-}" == "--notify" ]]; then
  NOTIFY=1
  shift
fi

if (( $# == 0 )); then
  print -u2 "usage: toaiff [--notify] PATH [PATH ...]"
  exit 64
fi

typeset -i converted=0 skipped=0 failed=0

LOG_FILE="${TOAIFF_LOG:-$HOME/Library/Logs/toaiff.log}"
mkdir -p "${LOG_FILE:h}" 2>/dev/null

log_line() {
  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG_FILE" 2>/dev/null
}

ensure_tools() {
  if (( $+commands[ffmpeg] && $+commands[ffprobe] )); then
    return 0
  fi
  if (( ! $+commands[brew] )); then
    print -u2 "toaiff: ffmpeg/ffprobe not found and Homebrew is unavailable to install them."
    print -u2 "        Install Homebrew (https://brew.sh) or ffmpeg, then retry."
    exit 69
  fi
  print -u2 "toaiff: installing ffmpeg via Homebrew…"
  if ! brew install ffmpeg; then
    print -u2 "toaiff: 'brew install ffmpeg' failed."
    exit 69
  fi
}

# Recognised audio file extensions (lowercased). Anything not in this set is
# left alone without even probing it, so non-audio files can never be misread
# as audio. Lossy extensions are included so they get probed and then skipped
# by codec; non-audio extensions are rejected outright.
is_audio_ext() {
  case "$1" in
    flac|wav|wave|w64|rf64|bwf|aif|aiff|aifc|m4a|m4b|mp4|caf|alac|ape|wv|tak|tta|mlp|thd|shn|dsf|dff) return 0 ;;
    mp3|aac|ogg|oga|opus|wma|ac3|eac3|dts|mka|aifr) return 0 ;;
    *) return 1 ;;
  esac
}

# A codec name is lossless if it is on the allowlist, or any PCM variant.
# Unknown codecs are treated as not-lossless and left untouched.
is_lossless() {
  case "$1" in
    flac|alac|wavpack|ape|tak|tta|mlp|truehd) return 0 ;;
    pcm_*) return 0 ;;
    *) return 1 ;;
  esac
}

# Choose a big-endian PCM target whose depth is >= the source depth, so the
# conversion is bit-exact (no truncation, no resampling).
target_codec() {
  local bits="$1" fmt="$2"
  case "$fmt" in
    flt|fltp) print -r -- pcm_f32be; return ;;
    dbl|dblp) print -r -- pcm_f64be; return ;;
  esac
  if [[ -z "$bits" || "$bits" == "N/A" ]]; then
    case "$fmt" in
      u8|s8)     bits=8 ;;
      s16|s16p)  bits=16 ;;
      s32|s32p)  bits=32 ;;
      *)         bits=16 ;;
    esac
  fi
  if   (( bits <= 8  )); then print -r -- pcm_s8
  elif (( bits <= 16 )); then print -r -- pcm_s16be
  elif (( bits <= 24 )); then print -r -- pcm_s24be
  else                        print -r -- pcm_s32be
  fi
}

trash_original() {
  [[ -n "${TOAIFF_KEEP_ORIGINALS:-}" ]] && return 0
  local abs="${1:A}"
  # Use NSFileManager (not Apple Events to Finder): moves to Trash with Put Back
  # support and, crucially, never triggers the "control Finder" automation prompt
  # that would otherwise stall a Finder Quick Action on first use.
  /usr/bin/osascript -l JavaScript \
    -e 'ObjC.import("Foundation");' \
    -e 'function run(argv){var fm=$.NSFileManager.defaultManager;var u=$.NSURL.fileURLWithPath(argv[0]);return fm.trashItemAtURLResultingItemURLError(u,null,null)?"":"fail";}' \
    "$abs" >/dev/null 2>&1 && return 0
  # Fallback: move into ~/.Trash directly.
  mv -f -- "$abs" "$HOME/.Trash/" 2>/dev/null
}

# A produced file counts as a valid AIFF only if ffprobe can read an audio
# stream from it — guards against trashing the original when ffmpeg exited 0
# but wrote something unplayable.
valid_aiff() {
  ffprobe -v error -select_streams a:0 -show_entries stream=codec_name \
    -of default=nw=1:nk=1 -- "$1" 2>/dev/null | grep -q .
}

# Best-effort removal of a failed/partial output. ffmpeg created it, so a plain
# rm can be denied inside a protected folder; fall back to NSFileManager trash.
discard_output() {
  local f="$1"
  [[ -e "$f" ]] || return 0
  rm -f -- "$f" 2>/dev/null && return 0
  /usr/bin/osascript -l JavaScript \
    -e 'ObjC.import("Foundation");' \
    -e 'function run(a){var fm=$.NSFileManager.defaultManager;var u=$.NSURL.fileURLWithPath(a[0]);fm.trashItemAtURLResultingItemURLError(u,null,null);return "";}' \
    "${f:A}" >/dev/null 2>&1
}

# Sets CONVERT_ERR on total failure and ART_DROPPED when the art-preserving
# attempt fails but the audio-only fallback succeeds. Writes straight to "$out".
convert_file() {
  local src="$1" tgt="$2" out="$3"
  CONVERT_ERR=""
  ART_DROPPED=0
  # First attempt keeps every stream (audio + embedded cover art).
  if ffmpeg -nostdin -hide_banner -loglevel error -y \
        -i "$src" -map 0 -map_metadata 0 \
        -c:a "$tgt" -c:v copy -write_id3v2 1 -f aiff "$out" 2>/dev/null; then
    return 0
  fi
  # Fallback: audio + metadata only (drops art the AIFF muxer rejected).
  local err
  err=$(ffmpeg -nostdin -hide_banner -loglevel error -y \
        -i "$src" -map 0:a -map_metadata 0 \
        -c:a "$tgt" -write_id3v2 1 -f aiff "$out" 2>&1) && { ART_DROPPED=1; return 0; }
  CONVERT_ERR="${err//$'\n'/ | }"
  return 1
}

process_file() {
  local src="$1"
  local ext="${src:e:l}"

  # Only consider files with a recognised audio extension. This is a safety net:
  # without it ffmpeg will happily mis-detect unrelated files (e.g. a `.al` text
  # file as raw A-law audio) and "convert" them. Extension gate first, codec
  # check second.
  is_audio_ext "$ext" || return

  # Empty file → skip (treat like a non-audio file, never a failure).
  [[ -s "$src" ]] || return

  local info codec bits fmt
  info=$(ffprobe -v error -select_streams a:0 \
           -show_entries stream=codec_name,sample_fmt,bits_per_raw_sample \
           -of default=nw=1 -- "$src" 2>/dev/null)
  codec=$(print -r -- "$info" | awk -F= '$1=="codec_name"{print $2; exit}')

  # No audio stream → not an audio file. Do nothing.
  [[ -z "$codec" ]] && return

  if [[ "$ext" == (aiff|aif|aifc) && "$codec" == pcm_* ]]; then
    log_line "SKIP (already aiff) $src"
    (( skipped++ )); return
  fi

  if ! is_lossless "$codec"; then
    log_line "SKIP (lossy/unsupported: $codec) $src"
    (( skipped++ )); return
  fi

  bits=$(print -r -- "$info" | awk -F= '$1=="bits_per_raw_sample"{print $2; exit}')
  fmt=$(print -r -- "$info" | awk -F= '$1=="sample_fmt"{print $2; exit}')

  # Truncated/corrupt file: ffprobe guessed the codec from the extension but
  # cannot determine a sample format. Skip rather than fail the whole run.
  if [[ -z "$fmt" || "$fmt" == "unknown" ]]; then
    log_line "SKIP (unreadable audio) $src"
    (( skipped++ )); return
  fi

  local dest="${src:r}.aiff"
  if [[ -e "$dest" && "${dest:A}" != "${src:A}" ]]; then
    print -u2 "toaiff: skip ${src:t} — ${dest:t} already exists"
    log_line "SKIP (target exists) $src"
    (( skipped++ )); return
  fi

  local tgt; tgt=$(target_codec "$bits" "$fmt")

  # ffmpeg writes the AIFF DIRECTLY to its final path — no temp file, no rename.
  # A sandboxed Finder Quick Action (run by ShortcutsMacHelper) lets ffmpeg
  # CREATE files even inside TCC-protected folders, but the shell may NOT
  # rename/delete a file a child process (ffmpeg) created — which is why the
  # old "ffmpeg → temp, shell mv → dest" approach failed in Downloads/Desktop/
  # Documents. The original is trashed only after the output is verified valid.
  if convert_file "$src" "$tgt" "$dest" && [[ -s "$dest" ]] && valid_aiff "$dest"; then
    trash_original "$src"
    print -u2 -- "toaiff: converted ${src:t} → ${dest:t} ($tgt)"
    if (( ART_DROPPED )); then
      print -u2 "toaiff: note: dropped unembeddable artwork for ${src:t}"
      log_line "CONVERTED (artwork dropped) $src -> $dest [$tgt]"
    else
      log_line "CONVERTED $src -> $dest [$tgt]"
    fi
    (( converted++ ))
  else
    discard_output "$dest"
    print -u2 "toaiff: FAILED ${src:t}"
    log_line "FAILED $src [$tgt] :: ${CONVERT_ERR:-unknown error}"
    (( failed++ ))
  fi
}

# Recursing one of these would scan an enormous tree and trash audio all over
# the system. Refuse them outright — a real target is always a specific file or
# album folder, never a filesystem root or a whole home/library directory.
is_forbidden_root() {
  local abs="${1:A}"
  case "$abs" in
    / | "$HOME" | /Users | /System | /Library | /Applications \
      | /usr | /sbin | /bin | /etc | /var | /private | /opt | /cores | /Volumes) return 0 ;;
    /System/* | /usr/*) return 0 ;;
  esac
  return 1
}

process_path() {
  local p="$1"
  if is_forbidden_root "$p"; then
    print -u2 "toaiff: refusing to recurse '$p' (too broad — point me at a file or an album folder)"
    log_line "REFUSED (forbidden root) $p"
    return
  fi
  if [[ -d "$p" ]]; then
    local file
    while IFS= read -r -d '' file; do
      process_file "$file"
    done < <(find "$p" -type f -print0)
  elif [[ -f "$p" ]]; then
    process_file "$p"
  else
    print -u2 "toaiff: not found: $p"
  fi
}

# Non-destructive diagnostic: `toaiff --check-root PATH` exits 0 if PATH is a
# forbidden (too-broad) root, 2 if it would be processed. Used by the tests to
# verify the guard without ever scanning a real root.
if [[ "${1:-}" == "--check-root" ]]; then
  is_forbidden_root "${2:-}" && exit 0 || exit 2
fi

ensure_tools

log_line "RUN start: $*"

for arg in "$@"; do
  process_path "$arg"
done

# Human-readable summary goes to stderr, not stdout: a Shortcuts "Run Shell
# Script" action captures stdout as its output and would otherwise save it as a
# stray "stdout.txt" next to the converted files.
print -u2 -- "toaiff: ${converted} converted, ${skipped} skipped, ${failed} failed"
log_line "RUN done: ${converted} converted, ${skipped} skipped, ${failed} failed"

if (( NOTIFY )); then
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "Convert to AIFF"' \
    -e 'end run' \
    "${converted} converted · ${skipped} skipped · ${failed} failed" >/dev/null 2>&1
fi

(( failed == 0 ))

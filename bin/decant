#!/usr/bin/env zsh
#
# decant — convert lossless audio to AIFF without quality reduction, and
# lossy .m4a/.opus files to MP3 at the highest bitrate that does not exceed
# the source's (so a lossy file is never inflated past its real quality).
#
# Works on a single file or a folder (recursing into all subfolders).
# Other lossy and non-audio files are left untouched. Each converted
# original is moved to the Trash once its output is written successfully.
#
# Usage:
#   decant [--notify] [--debug] [--dry-run] [--keep] [--no-enrich] [--jobs N] [--] PATH [PATH ...]
#   decant --help
#   decant --version

emulate -L zsh
setopt pipefail extended_glob

DECANT_VERSION="0.3.0"

# Opt-in parallelism, and meant to stay opt-in until concurrency has earned the
# trust: decant trashes originals, and two ffmpegs racing onto one destination
# would cost the user both the output and the source that made it.
typeset -i JOBS=1 JOBS_MAX=64 JOBS_GIVEN=0
JOBS_REQUEST=""

# GUI-launched processes (Finder Quick Action / Automator) inherit a minimal
# PATH that omits Homebrew, so ffmpeg/ffprobe/brew would be invisible. Add the
# standard Homebrew bin directories — but only *ahead* of the inherited PATH
# when the tools are missing outright, so a deliberately chosen ffmpeg (a static
# build with extra encoders, MacPorts, Nix, a newer local build) keeps winning
# wherever the caller already put it first.
if (( $+commands[ffmpeg] && $+commands[ffprobe] )); then
  path+=(/opt/homebrew/bin /usr/local/bin)
else
  path=(/opt/homebrew/bin /usr/local/bin $path)
fi

NOTIFY=0
DEBUG=0
DRYRUN=0
ENRICH=1
[[ -n "${DECANT_DEBUG:-}" ]] && DEBUG=1
[[ -n "${DECANT_NO_ENRICH:-}" ]] && ENRICH=0

usage() {
  print -r -- "decant $DECANT_VERSION — lossless audio → AIFF, lossy .m4a/.opus → MP3.

usage: decant [OPTIONS] PATH [PATH ...]

Options:
  --notify        Post a completion notification (used by the Quick Action).
  --debug         Log every run/conversion/skip, not just errors.
  --dry-run       Preview the tag/conversion plan; write and trash nothing.
  --keep          Convert without trashing the originals.
  --no-enrich     Pure transcode; skip all tag enrichment.
  --jobs N        Convert N files at once. Default 1 (serial); 'auto' is the
                  machine's logical core count. At most $JOBS_MAX workers.
  --version       Print the version and exit.
  -h, --help      Print this help and exit.
  --              Treat every remaining argument as a path.

Environment:
  DECANT_DEBUG            Same as --debug.
  DECANT_NO_ENRICH        Same as --no-enrich.
  DECANT_KEEP_ORIGINALS   Same as --keep.
  DECANT_JOBS             Same as --jobs.
  DECANT_NO_NOTIFY        Suppress the notification even with --notify.
  DECANT_NO_SOXR          Resample with ffmpeg's default engine, not libsoxr.
  DECANT_LOG              Log file path (default ~/Library/Logs/decant.log).

Exit status:
  0   nothing was left undone — conversions, skips and dry runs all count
  1   at least one file failed to convert
  64  usage error: no paths given, or an unrecognised option
  66  a given path does not exist
  69  ffmpeg/ffprobe are unavailable and were not installed
  77  refused a path that is too broad to recurse (a filesystem or home root)
  130 interrupted by a signal — 128 + its number, so 143 for TERM, 129 for HUP

Examples:
  decant ~/Music/Album              # recurse a folder
  decant track.flac other.wav       # one or more files
  decant --dry-run ~/Music/Album    # preview the plan, write nothing
  decant -- -weird-name.flac        # a path that starts with a dash"
}

# The hidden diagnostic dispatches at the foot of the script are matched on the
# raw first argument and can only run once their helper functions are defined,
# so option parsing has to leave them (and the rest of the line) alone.
typeset -i HIDDEN_DISPATCH=0
case "${1:-}" in
  --check-root|--detect-catalog|--derive-track-disc|--normalize-feat|--mp3-bitrate \
    |--is-audio-ext|--classify-codec|--folder-art|--resample-args) HIDDEN_DISPATCH=1 ;;
esac

typeset -a TARGETS
typeset -i END_OF_OPTS=0 WANT_JOBS=0
if (( ! HIDDEN_DISPATCH )); then
  # Options are recognised anywhere before "--"; everything else is a path.
  # Iterating rather than shifting keeps "$@" intact for the RUN start log line.
  for arg in "$@"; do
    if (( END_OF_OPTS )); then TARGETS+=("$arg"); continue; fi
    # --jobs is the only option carrying a separate value, and this loop
    # iterates rather than shifts, so the value is claimed on the pass after
    # the flag. After "--" the same word is a path, which is why this sits
    # below the END_OF_OPTS check rather than above it.
    if (( WANT_JOBS )); then JOBS_REQUEST="$arg"; JOBS_GIVEN=1; WANT_JOBS=0; continue; fi
    case "$arg" in
      --notify)    NOTIFY=1 ;;
      --debug)     DEBUG=1 ;;
      --dry-run)   DRYRUN=1 ;;
      # The flag form of DECANT_KEEP_ORIGINALS. Setting the variable rather than
      # a second one keeps a single source of truth for "do not trash", so the
      # flag and the env var can never disagree.
      --keep)      DECANT_KEEP_ORIGINALS=1 ;;
      --no-enrich) ENRICH=0 ;;
      --jobs)      WANT_JOBS=1 ;;
      --jobs=*)    JOBS_REQUEST="${arg#--jobs=}"; JOBS_GIVEN=1 ;;
      --version)   print -r -- "decant $DECANT_VERSION"; exit 0 ;;
      -h|--help)   usage; exit 0 ;;
      --)          END_OF_OPTS=1 ;;
      # A mistyped flag used to fall through and be treated as a filename, so a
      # typo looked like a clean run. A bare "-" is left as a path.
      -?*)         print -u2 -- "decant: unknown option: $arg"
                   print -u2 -- "       try 'decant --help' for usage"
                   exit 64 ;;
      *)           TARGETS+=("$arg") ;;
    esac
  done

  if (( WANT_JOBS )); then
    print -u2 -- "decant: --jobs needs a value: a positive whole number, or 'auto'"
    print -u2 -- "       try 'decant --help' for usage"
    exit 64
  fi

  if (( ${#TARGETS} == 0 )); then
    print -u2 -- "usage: decant [OPTIONS] PATH [PATH ...]"
    print -u2 -- "       try 'decant --help' for usage"
    exit 64
  fi
fi

# Globals that one function fills in for another to read: build_meta_args sets
# the first three, process_file the encoder options, convert_file the two
# outcome flags, probe_source everything the run knows about the source file.
# Declared here so the hand-off is stated rather than implied.
typeset -ga META_ARGS META_PLAN ENC_EXTRA
typeset -g  ART_INPUT CONVERT_ERR ART_DROPPED
typeset -g  SRC_CODEC SRC_FMT SRC_RATE SRC_BITS SRC_BITRATE SRC_DURATION \
            SRC_ART_CODEC SRC_TRACK SRC_DISC SRC_GROUPING SRC_TITLE
typeset -gi SRC_HAS_ART

typeset -i converted=0 skipped=0 failed=0 previewed=0 missing=0 refused=0

# Parallel-run state, every one of it empty in a serial run: the live worker
# PIDs, the scratch directory they report through, this worker's own in-flight
# file, the file list a batch of workers is striped across and which worker owns
# each entry of it, and the plain-file arguments still waiting to be batched.
typeset -ga WORKER_PIDS BATCH_FILES PENDING_FILES
typeset -gai BATCH_ASSIGN
typeset -g  STATE_DIR="" INFLIGHT_FILE=""

# Skips are ordinary, so only real problems change the status. When several
# occur in one run the most severe wins, in this order.
run_status() {
  (( failed ))  && return 1
  (( refused )) && return 77
  (( missing )) && return 66
  return 0
}

# One central, always-appended log regardless of where the action is run from.
# (DECANT_LOG only overrides the path for the test suite.)
LOG_FILE="${DECANT_LOG:-$HOME/Library/Logs/decant.log}"
mkdir -p "${LOG_FILE:h}" 2>/dev/null

# zsh's own strftime/zstat, so neither timestamping a line nor sizing the log
# costs a fork — a --debug run over a large library logs once per file.
zmodload zsh/datetime
zmodload -F zsh/stat b:zstat

# The log is appended to forever, so cap it: once it reaches 2 MB the current
# file becomes decant.log.1 (one generation kept, the older one discarded) and
# this run continues into a fresh file. Checked once per run — on the first line
# written, so nothing this run logs can land in the file being rotated away.
# A rotation that cannot happen is never fatal: an oversized log is a far better
# outcome than a failed conversion.
typeset -i LOG_MAX_BYTES=2097152 LOG_ROTATE_CHECKED=0
rotate_log() {
  LOG_ROTATE_CHECKED=1
  local -a st
  zstat -A st +size "$LOG_FILE" 2>/dev/null || return 0
  (( st[1] >= LOG_MAX_BYTES )) && mv -f -- "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
  return 0
}

# Errors (FAILED / REFUSED / MISSING) are logged always. Everything else
# (per-file conversions, skips, run markers) only with --debug / DECANT_DEBUG.
log_line() {
  (( LOG_ROTATE_CHECKED )) || rotate_log
  local ts; strftime -s ts '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS
  print -r -- "$ts $1" >> "$LOG_FILE" 2>/dev/null
}
log_debug() {
  (( DEBUG )) && log_line "$1"
}

# Concise user-facing summary: only mention the categories that actually
# occurred. e.g. all-success → "3 converted"; mixed → "3 converted · 1 skipped".
summary_line() {
  local parts=()
  (( converted )) && parts+=("${converted} converted")
  (( skipped ))   && parts+=("${skipped} skipped")
  (( failed ))    && parts+=("${failed} failed")
  (( ${#parts} )) && print -r -- "${(j: · :)parts}" || print -r -- "no audio files to convert"
}

notify() {
  [[ -n "${DECANT_NO_NOTIFY:-}" ]] && return 0
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "Decant"' \
    -e 'end run' \
    "$1" >/dev/null 2>&1
}

# ffmpeg is missing and this run cannot get it. Say so on every channel the
# caller might be listening to: stderr for a terminal, the notification for the
# Quick Action (whose stderr goes to a file nobody reads), the log for later.
no_tools() {
  print -u2 -- "decant: $1"
  print -u2 -- "        $2"
  (( NOTIFY )) && notify "$1 $2"
  log_line "NO FFMPEG :: $1 $2"
  exit 69
}

ensure_tools() {
  if (( $+commands[ffmpeg] && $+commands[ffprobe] )); then
    return 0
  fi
  if (( ! $+commands[brew] )); then
    no_tools "ffmpeg/ffprobe not found and Homebrew is unavailable to install them." \
             "Install Homebrew (https://brew.sh) or ffmpeg, then retry."
  fi
  # 'brew install ffmpeg' downloads hundreds of megabytes over several minutes.
  # Without a terminal (Quick Action, cron, CI) there is nobody to consent and
  # nowhere to show progress — a right-click would simply appear to hang — so
  # name the command the user should run and stop.
  if [[ ! -t 0 ]]; then
    no_tools "ffmpeg/ffprobe not found." \
             "Run 'brew install ffmpeg', then retry."
  fi
  print -u2 -n -- "decant: ffmpeg/ffprobe not found. Install ffmpeg via Homebrew now (several hundred MB)? [y/N] "
  local reply; read -r reply
  if [[ "${reply:l}" != (y|yes) ]]; then
    no_tools "ffmpeg was not installed." \
             "Run 'brew install ffmpeg' when you are ready, then retry."
  fi
  if ! brew install ffmpeg; then
    no_tools "'brew install ffmpeg' failed." \
             "Install ffmpeg manually, then retry."
  fi
}

# Recognised audio file extensions (lowercased). Anything not in this set is
# left alone without even probing it, so non-audio files can never be misread
# as audio. Lossy extensions are included so they get probed and then skipped
# by codec; non-audio extensions are rejected outright.
is_audio_ext() {
  case "$1" in
    flac|wav|wave|w64|rf64|bwf|aif|aiff|aifc|m4a|m4b|mp4|caf|alac|ape|wv|tak|tta|mlp|thd|shn|dsf|dff) return 0 ;;
    mp3|aac|ogg|oga|opus|wma|ac3|eac3|dts|mka) return 0 ;;
    *) return 1 ;;
  esac
}

# A codec name is lossless if it is on the allowlist, or any PCM variant.
# Unknown codecs are treated as not-lossless and left untouched.
is_lossless() {
  case "$1" in
    flac|alac|wavpack|ape|tak|tta|mlp|truehd|shorten) return 0 ;;
    pcm_*) return 0 ;;
    *) return 1 ;;
  esac
}

# DSD is lossless, but decimating 1-bit sigma-delta down to multi-bit PCM is a
# re-recording, not a copy — no AIFF we could write would be the same audio. So
# .dsf/.dff are recognised and declined by name rather than lumped in with the
# lossy codecs, whose skip reason would be a plain lie about DSD.
is_dsd() {
  case "$1" in
    dsd_*) return 0 ;;
    *) return 1 ;;
  esac
}

# ── Returning a value without forking ───────────────────────────────────────
# The helpers from here down hand their result back in REPLY instead of
# printing it. A $(…) around a function that is otherwise pure zsh forks a
# whole subshell just to carry one string up a stack frame, and a converted
# file goes through seven of them — thousands of processes over a library.
# Every one of these sets REPLY on every path, so a value can never be left
# over from the previous file; those that mean "nothing found" also return
# non-zero, which is what the hidden --* dispatches print on.

# Choose a big-endian PCM target whose depth is >= the source depth, so the
# conversion is bit-exact (no truncation, no resampling). Sets REPLY.
target_codec() {
  local bits="$1" fmt="$2"
  case "$fmt" in
    flt|fltp) REPLY=pcm_f32be; return ;;
    dbl|dblp) REPLY=pcm_f64be; return ;;
  esac
  if [[ -z "$bits" || "$bits" == "N/A" ]]; then
    case "$fmt" in
      u8|s8)     bits=8 ;;
      s16|s16p)  bits=16 ;;
      s32|s32p)  bits=32 ;;
      *)         bits=16 ;;
    esac
  fi
  if   (( bits <= 8  )); then REPLY=pcm_s8
  elif (( bits <= 16 )); then REPLY=pcm_s16be
  elif (( bits <= 24 )); then REPLY=pcm_s24be
  else                        REPLY=pcm_s32be
  fi
}

# ── One probe per source ────────────────────────────────────────────────────
# Every fact decant needs about a source — codec, sample format, rate, depth,
# bitrate, duration, cover art and the four enrichment tags — comes out of a
# single ffprobe call and is picked apart here in the shell. It used to take
# four separate probes for a FLAC and eight for an Opus, each with an awk or a
# grep behind it to pull one value out of one line.
#
# -of flat is the writer that survives hostile tag values. Every entry is
# exactly one line of key.path=value; the key path is built by ffprobe from the
# section hierarchy, and \n and \r are escaped inside values, so no tag can
# forge a line — let alone a section — the way it can with the default writer's
# [STREAM] wrappers. (-of json escapes just as safely, but it nests, and it
# omits any field whose value is "N/A" — precisely the answer target_codec and
# source_bitrate need to see for bits_per_raw_sample and bit_rate.)

# Undo the flat writer's escaping into REPLY. It escapes exactly six characters
# — \n \r \\ \" \` \$ — and nothing else, so splitting on the two-character \\
# first is what makes the rest unambiguous: every backslash still standing after
# that split introduces a one-character escape.
_unflat() {
  REPLY="$1"
  [[ "$REPLY" == *'\'* ]] || return 0
  local p nl=$'\n' cr=$'\r'
  local -a parts
  local -i i
  parts=("${(@ps:\\\\:)REPLY}")
  for (( i = 1; i <= ${#parts}; i++ )); do
    p="${parts[i]}"
    p="${p//\\n/$nl}"
    p="${p//\\r/$cr}"
    p="${p//\\\"/\"}"
    p="${p//\\\`/\`}"
    p="${p//\\\$/\$}"
    parts[i]="$p"
  done
  REPLY="${(pj:\\:)parts}"
}

# Fill the SRC_* globals for FILE. All of them stay empty when ffprobe cannot
# read the file at all (a truncated one prints nothing), which the caller reads
# as "no audio stream here" exactly as it did before.
probe_source() {
  SRC_CODEC=""; SRC_FMT=""; SRC_RATE=""; SRC_BITS=""; SRC_BITRATE=""
  SRC_DURATION=""; SRC_ART_CODEC=""; SRC_HAS_ART=0
  SRC_TRACK=""; SRC_DISC=""; SRC_GROUPING=""; SRC_TITLE=""

  local out
  out=$(ffprobe -v error -of flat -show_entries \
    "stream=codec_type,codec_name,sample_fmt,sample_rate,bits_per_raw_sample,bit_rate:stream_tags=track,disc,grouping,title:format=duration:format_tags=track,disc,grouping,title" \
    -- "$1" 2>/dev/null)

  # Tag keys are matched case-insensitively and folded to lower case before
  # they are stored. Vorbis comments are conventionally upper case and the spec
  # calls their keys case-insensitive, so a spec-following FLAC or Opus arrives
  # here as TITLE/GROUPING; Matroska upper-cases DISC and GROUPING on its own,
  # and an MP3's TXXX frames keep whatever case they were written with. A
  # case-sensitive match reads all of those as absent — and "absent" is the one
  # answer that makes fill-gaps-only overwrite a tag the user already had.
  #
  # Where a tag is spelled more than once, the first one ffprobe prints wins:
  # streams before the format, streams in index order. That is a fixed total
  # order over the file, so the winner never depends on which case a key
  # happened to be written in. Two spellings cannot collide *within* one
  # section — ffprobe's own dictionary is case-insensitive and merges them
  # before printing.
  local line key val field idx tag
  local -A stype scodec sfmt srate sbits sbrate tags
  for line in "${(@f)out}"; do
    key="${line%%=*}"
    val="${line#*=}"
    # The flat writer quotes strings and leaves numbers bare.
    [[ "$val" == \"*\" ]] && val="${val[2,-2]}"
    case "$key" in
      streams.stream.<->.*)
        field="${key#streams.stream.}"
        idx="${field%%.*}"
        field="${field#*.}"
        case "$field" in
          codec_type)          stype[$idx]="$val" ;;
          codec_name)          scodec[$idx]="$val" ;;
          sample_fmt)          sfmt[$idx]="$val" ;;
          sample_rate)         srate[$idx]="$val" ;;
          bits_per_raw_sample) sbits[$idx]="$val" ;;
          bit_rate)            sbrate[$idx]="$val" ;;
          # Ogg-family sources keep their Vorbis comments on the stream rather
          # than the format, so stream tags are read too.
          tags.(#i)(track|disc|grouping|title))
            tag="${${field#tags.}:l}"
            (( ${+tags[$tag]} )) || { _unflat "$val"; tags[$tag]="$REPLY" } ;;
        esac ;;
      format.duration) SRC_DURATION="$val" ;;
      format.tags.(#i)(track|disc|grouping|title))
        tag="${${key#format.tags.}:l}"
        (( ${+tags[$tag]} )) || { _unflat "$val"; tags[$tag]="$REPLY" } ;;
    esac
  done

  # The first audio and the first video stream in the file's own order — what
  # -select_streams a:0 and v:0 used to pick out. A source's cover art is any
  # video stream at all: Matroska carries real artwork without the attached_pic
  # disposition, so the flag cannot be the test.
  local i
  for i in ${(onk)stype}; do
    case "${stype[$i]}" in
      audio)
        [[ -n "$SRC_CODEC" ]] && continue
        SRC_CODEC="${scodec[$i]}"; SRC_FMT="${sfmt[$i]}"; SRC_RATE="${srate[$i]}"
        SRC_BITS="${sbits[$i]}";   SRC_BITRATE="${sbrate[$i]}" ;;
      video)
        (( SRC_HAS_ART )) && continue
        SRC_HAS_ART=1; SRC_ART_CODEC="${scodec[$i]}" ;;
    esac
  done

  SRC_TRACK="${tags[track]}";    SRC_DISC="${tags[disc]}"
  SRC_GROUPING="${tags[grouping]}"; SRC_TITLE="${tags[title]}"
}

# Set REPLY to the source audio bitrate in bps, or empty when it cannot be
# measured.
# Uses the stream's own value when ffprobe knows it; otherwise (Ogg/Opus never
# stores one) sums the audio packet sizes — NOT the container average, which
# counts tags and artwork and would overstate the real audio bitrate. Summing
# packets is the one measurement the source probe cannot carry, so it costs a
# second ffprobe — charged only to the files that have no stream bit_rate and a
# duration to divide the sum by, since without both there is no rate to reach.
source_bitrate() {
  local br="$SRC_BITRATE"
  REPLY=""
  if [[ "$br" != <-> ]]; then
    [[ "$SRC_DURATION" == (<->|<->.<->) ]] && (( SRC_DURATION > 0 )) || return 0
    br=$(ffprobe -v error -select_streams a:0 -show_entries packet=size \
           -of csv=p=0 -- "$1" 2>/dev/null |
         awk -v dur="$SRC_DURATION" 'NF{s+=$1} END{if (s>0 && dur+0>0) printf "%d", s*8/dur}')
  fi
  [[ "$br" == <-> ]] && REPLY="$br"
}

# Set REPLY to the highest standard MP3 CBR bitrate (kbps) that does not
# exceed the source bitrate, so a lossy source is never inflated past its real
# quality. An unknown source bitrate gets the best MP3 can do (320). The one
# exception to the cap: 32 kbps is MPEG-1 Layer III's minimum, so anything
# below that encodes at 32.
mp3_bitrate_for() {
  local bps="$1" r
  # Only a plain digit string is a bitrate. zsh's arithmetic context expands a
  # non-numeric operand as a variable *name* and keeps expanding recursively, so
  # anything else has to be rejected here rather than reaching the comparison.
  if [[ "$bps" == <-> ]]; then
    for r in 320 256 224 192 160 128 112 96 80 64 56 48 40 32; do
      (( bps >= r * 1000 )) && { REPLY="$r"; return }
    done
    REPLY=32
  else
    REPLY=320
  fi
}

# libsoxr resamples measurably more cleanly than swresample's built-in engine,
# but it is an optional ffmpeg build dependency (Homebrew's bottle ships
# without it). `ffmpeg -h filter=aresample` advertises `soxr` as an option
# value even on builds that lack the library, so the only trustworthy test is
# to actually run a hundredth of a second through it. Probed at most once per
# run, and only when a file really needs resampling.
typeset -i _soxr=-1
has_soxr() {
  if (( _soxr < 0 )); then
    if [[ -n "${DECANT_NO_SOXR:-}" ]]; then
      _soxr=0
    elif ffmpeg -nostdin -hide_banner -v quiet -f lavfi -i "anullsrc=r=8000:cl=mono" \
           -t 0.01 -af "aresample=resampler=soxr:precision=28" -ar 16000 \
           -f null - >/dev/null 2>&1; then
      _soxr=1
    else
      _soxr=0
    fi
  fi
  (( _soxr ))
}

# Set RESAMPLE_ARGS to the ffmpeg options that move a source at SR onto a rate
# CDJs can play (32/44.1/48 kHz, the MPEG-1 Layer III set), or leave it empty
# when the source is already on one. Above 48 kHz goes to 48 kHz so the extra
# bandwidth is halved rather than quartered; everything else goes to 44.1 kHz.
cdj_resample_args() {
  local sr="$1"
  RESAMPLE_ARGS=()
  case "$sr" in
    32000|44100|48000) return 0 ;;
  esac
  local target=44100
  [[ "$sr" == <-> ]] && (( sr > 48000 )) && target=48000
  RESAMPLE_ARGS=(-ar "$target")
  has_soxr && RESAMPLE_ARGS+=(-af "aresample=resampler=soxr:precision=28")
  return 0
}

# ── Metadata enrichment ─────────────────────────────────────────────────────
# Derive tags that live in folder/file names but are missing from the audio
# tags, and normalise feat.→ft. All derivation is fill-gaps-only (set by
# build_meta_args); the only value that is *edited* rather than gap-filled is a
# title containing "feat.".

# Set REPLY to the title with the word "feat." (any case) replaced by "ft.".
# The literal dot is required, so "FEISTY"/"feature" are left alone. Idempotent.
normalize_feat() {
  REPLY="${1//(#bi)feat./ft.}"
}

# Tokens that look like letters+digits but are format/quality markers, not
# catalog numbers.
_cat_blocklist=(FLAC WAV WAVE W64 RF64 BWF MP3 AAC ALAC APE WV WEB WEBFLAC \
  CD VINYL EP LP VA OST MIXTAPE REMIX REMIXES MP4 M4A AIFF AIF)

# True if TOKEN looks like a catalog number: starts with >=2 letters, is
# otherwise alphanumeric (separators allowed), and contains a run of >=2 digits
# somewhere — so it matches both simple codes (SHA300, NB011EP) and segmented
# ones (BASS372D003, SLSS-012). Rejects blocklisted words, years, pure-digit
# barcodes, and bit/rate strings.
_is_catalog_token() {
  local t="${1:u}"
  [[ "$t" == [A-Z](#c2,)[-_A-Z0-9]# ]] || return 1
  [[ "$t" == *[0-9][0-9]* ]] || return 1
  (( ${_cat_blocklist[(I)$t]} )) && return 1
  [[ "$t" == (19|20)[0-9][0-9] ]] && return 1
  [[ "$t" == [0-9]## ]] && return 1
  [[ "$t" == *(KHZ|BIT|KBPS|HZ)* ]] && return 1
  return 0
}

# Set REPLY to an uppercase catalog number found in an album folder name, and
# return non-zero when there is none. Prefers a bracketed token ([], (), {})
# over a bare scene token; on ties takes the last one.
detect_catalog() {
  local name="$1" tok g closer
  local -a bracketed bare
  local -i i=1 j n=${#name}
  REPLY=""
  # Walk the name here rather than shelling out to `grep -oE`: one fork per file
  # cost more than reading every character of every folder name does. This is
  # the regex's own scan — a group runs from an opener to the next closer of the
  # SAME kind, so an opener of another kind in between belongs to the group it
  # sits in rather than starting one of its own.
  while (( i <= n )); do
    case "${name[i]}" in
      '[') closer=']' ;;
      '(') closer=')' ;;
      '{') closer='}' ;;
      *)   (( i++ )); continue ;;
    esac
    for (( j = i + 1; j <= n; j++ )); do
      [[ "${name[j]}" == "$closer" ]] && break
    done
    # An opener that never closes, or closes with nothing in between, is not a
    # group. Resuming one character along rather than past the closer is what
    # keeps a real group that follows such an opener — "{[SHA300]" — findable.
    if (( j > n || j == i + 1 )); then
      (( i++ )); continue
    fi
    g="${name[i+1,j-1]}"
    for tok in ${(s: :)${g//[][(){}]/ }}; do
      _is_catalog_token "$tok" && bracketed+=("${tok:u}")
    done
    i=j+1
  done
  for tok in ${(s: :)${name//[-_]/ }}; do
    _is_catalog_token "$tok" && bare+=("${tok:u}")
  done
  if   (( ${#bracketed} )); then REPLY="${bracketed[-1]}"
  elif (( ${#bare} ));      then REPLY="${bare[-1]}"
  fi
  [[ -n "$REPLY" ]]
}

# Set REPLY to "disc=N" and/or "track=N" parsed from the LEADING token of a
# filename (so trailing numbers like a year in the title are never mistaken for
# a track), and return non-zero when neither is there.
derive_track_disc() {
  local base="${1:t:r}"
  local -a out
  REPLY=""
  if [[ "$base" == (#b)[[:space:]]#\(([[:space:]]#<1-99>)[[:space:]]#-[[:space:]]#([[:space:]]#<1-999>)[[:space:]]#\)* ]]; then
    out=("disc=$((match[1]))" "track=$((match[2]))")
  elif [[ "$base" == (#b)[[:space:]]#(<1-999>)[[:space:]]#[-._\)]* ]]; then
    out=("track=$((match[1]))")
  fi
  (( ${#out} )) && REPLY="${(j: :)out}"
}

# Art names and extensions in explicit preference order. A single glob returns
# matches alphabetically, which would make the winner an accident of naming and
# would silently reshuffle the moment another name is added here.
_art_names=(cover folder front)
_art_exts=(jpg jpeg png)

# Set REPLY to the preferred art file sitting directly in DIR, and return
# non-zero when there is none. Zero-byte files are ignored so a placeholder can
# never displace a real cover.
_art_in_dir() {
  local dir="$1" name ext f
  local -a found
  REPLY=""
  found=("$dir"/(#i)(cover|folder|front).(jpg|jpeg|png)(N-.))
  for name in $_art_names; do
    for ext in $_art_exts; do
      for f in $found; do
        [[ "${${f:t}:l}" == "$name.$ext" && -s "$f" ]] && { REPLY="$f"; return 0 }
      done
    done
  done
  return 1
}

# True for a folder that names itself as one disc of a set: CD1, CD 2, Disc-03…
_is_disc_folder() {
  [[ "${1:l}" == (cd|disc|disk)[[:space:]._-]#<0-999> ]]
}

# Set REPLY to the path to cover art for a track living in DIR, and return
# non-zero when there is none. Every exit runs through _art_in_dir, which
# clears REPLY before it looks, so a miss cannot report the last file's cover.
#
# Multi-disc releases keep the artwork at the album root (Album/cover.jpg) and
# the tracks one level down (Album/CD1/…), so a disc folder falls back to its
# parent. ONLY a disc folder does, and only one level: any other directory's
# parent is just as likely to be a shared library root like ~/Music, whose
# stray cover.jpg belongs to nothing in particular — embedding it would stamp
# an unrelated image onto every album underneath.
find_folder_art() {
  local dir="$1"
  local up="${dir:h}"
  _art_in_dir "$dir" && return 0
  _is_disc_folder "${dir:t}" || return 1
  [[ "$up" != "$dir" ]] || return 1
  is_forbidden_root "$up" && return 1
  _art_in_dir "$up"
}

# Build META_ARGS (ffmpeg -metadata args), META_PLAN (human-readable summary)
# and ART_INPUT (a cover image to embed) for SRC, given its existing tags.
# Fill-gaps-only: derived fields are written only where the source tag is empty.
build_meta_args() {
  local src="$1" cur_track="$2" cur_disc="$3" cur_grouping="$4" cur_title="$5" has_art="$6"
  META_ARGS=(); META_PLAN=(); ART_INPUT=""
  local dir="${src:h}" folder="${src:h:t}" base="${src:t}"

  if [[ -z "$cur_grouping" ]]; then
    local cat; detect_catalog "$folder"; cat="$REPLY"
    [[ -n "$cat" ]] && { META_ARGS+=(-metadata "grouping=$cat"); META_PLAN+=("grouping=$cat"); }
  fi

  local td kv k; derive_track_disc "$base"; td="$REPLY"
  for kv in ${(s: :)td}; do
    k="${kv%%=*}"
    [[ "$k" == track && -n "$cur_track" ]] && continue
    [[ "$k" == disc  && -n "$cur_disc"  ]] && continue
    META_ARGS+=(-metadata "$kv"); META_PLAN+=("$kv")
  done

  if [[ -n "$cur_title" ]]; then
    local nt; normalize_feat "$cur_title"; nt="$REPLY"
    [[ "$nt" != "$cur_title" ]] && { META_ARGS+=(-metadata "title=$nt"); META_PLAN+=("title=$nt"); }
  fi

  if [[ "$has_art" != 1 ]]; then
    local art; find_folder_art "$dir"; art="$REPLY"
    [[ -n "$art" ]] && { ART_INPUT="$art"; META_PLAN+=("art=${art:t}"); }
  fi
}

# Echo a free path inside DIR for NAME, uniquified Finder-style ("Intro.flac",
# then "Intro 2.flac", "Intro 3.flac", …). The Trash is one flat namespace, so
# two albums with the same track name would otherwise collide.
trash_fallback_dest() {
  local dir="$1" base="${2:t}"
  local stem="${base:r}" ext="${base:e}" n=2 candidate
  [[ -n "$ext" ]] && ext=".$ext"
  # A name that is nothing but an extension (".flac") has no stem to number.
  [[ -z "$stem" ]] && { stem="$base"; ext="" }
  candidate="$dir/$base"
  while [[ -e "$candidate" ]]; do
    candidate="$dir/$stem $n$ext"
    (( n++ ))
  done
  print -r -- "$candidate"
}

# Returns non-zero when the original could NOT be trashed, so the caller can say
# so instead of implying the file is gone.
trash_original() {
  [[ -n "${DECANT_KEEP_ORIGINALS:-}" ]] && return 0
  local abs="${1:A}"
  # Use NSFileManager (not Apple Events to Finder): moves to Trash with Put Back
  # support and, crucially, never triggers the "control Finder" automation prompt
  # that would otherwise stall a Finder Quick Action on first use.
  # (DECANT_FORCE_TRASH_FALLBACK skips it so the tests can reach the fallback.)
  if [[ -z "${DECANT_FORCE_TRASH_FALLBACK:-}" ]]; then
    /usr/bin/osascript -l JavaScript \
      -e 'ObjC.import("Foundation");' \
      -e 'function run(argv){var fm=$.NSFileManager.defaultManager;var u=$.NSURL.fileURLWithPath(argv[0]);return fm.trashItemAtURLResultingItemURLError(u,null,null)?"":"fail";}' \
      "$abs" >/dev/null 2>&1 && return 0
  fi
  # Fallback: move into ~/.Trash directly. Also the path taken for files on an
  # external volume, where this becomes a cross-device copy into the home Trash.
  # Unlike NSFileManager this does not uniquify on its own, so pick a free name
  # rather than letting mv silently overwrite an earlier trashed file.
  local trash="${DECANT_TRASH_DIR:-$HOME/.Trash}"
  [[ -d "$trash" ]] || return 1
  mv -- "$abs" "$(trash_fallback_dest "$trash" "$abs")" 2>/dev/null
}

# A produced file counts as valid only if ffprobe can read an audio stream
# from it — guards against trashing the original when ffmpeg exited 0 but
# wrote something unplayable. Capturing rather than piping into `grep -q .`
# drops a fork per converted file; the explicit `|| return 1` is what keeps
# pipefail's half of the old test, so an ffprobe that fails still fails the
# file however much it managed to print first.
valid_audio() {
  local codec
  codec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name \
    -of default=nw=1:nk=1 -- "$1" 2>/dev/null) || return 1
  [[ -n "$codec" ]]
}

# Best-effort removal of a failed/partial output. ffmpeg created it, so a plain
# rm can be denied inside a protected folder; fall back to NSFileManager trash.
discard_output() {
  local f="$1"
  [[ -e "$f" ]] || return 0
  rm -f -- "$f" 2>/dev/null && return 0
  /usr/bin/osascript -l JavaScript \
    -e 'ObjC.import("Foundation");' \
    -e 'function run(a){var fm=$.NSFileManager.defaultManager;var u=$.NSURL.fileURLWithPath(a[0]);fm.trashItemAtURLResultingItemURLError(u,null,null);return "";}' \
    "${f:A}" >/dev/null 2>&1
}

# ffmpeg writes straight to the final destination (see the note in process_file),
# so a run killed mid-encode leaves an unplayable stub sitting at the output
# path. Hold the in-flight destination somewhere the handler can see it; empty
# means nothing is being written and there is nothing to clean up.
IN_FLIGHT_DEST=""

# Publish the destination ffmpeg is about to write. Inside a worker it also goes
# to that worker's own file, so the parent can still find every in-flight output
# after an interrupt — including one whose worker died before its own trap could
# run. One writer per file, so the state can never be two workers' paths spliced
# together. Always cleared BEFORE the original is trashed, which is what stops
# the sweep in stop_workers discarding a finished output whose source is gone.
set_inflight() {
  IN_FLIGHT_DEST="$1"
  [[ -n "$INFLIGHT_FILE" ]] || return 0
  if [[ -n "$1" ]]; then
    print -rn -- "$1" > "$INFLIGHT_FILE" 2>/dev/null
  else
    : > "$INFLIGHT_FILE" 2>/dev/null
  fi
  return 0
}

# A worker leaves the announcement to the parent — N workers must not print N
# copies of one interrupt. Dropping its own partial here is only the fast path;
# the parent sweeps the same state file afterwards either way.
worker_signal() {
  [[ -n "$IN_FLIGHT_DEST" ]] && discard_output "$IN_FLIGHT_DEST"
  exit 1
}

# Every process below PIDS, breadth-first. A worker's ffmpeg is a grandchild of
# this shell: killing the worker alone would leave that ffmpeg reparented to
# launchd and still writing into the very file we are about to discard.
worker_tree() {
  local -a queue kids seen
  local p kid
  queue=("$@")
  while (( ${#queue} )); do
    p="${queue[1]}"
    queue=("${(@)queue[2,-1]}")
    seen+=("$p")
    kids=(${(f)"$(pgrep -P $p 2>/dev/null)"})
    for kid in $kids; do
      [[ "$kid" == <-> ]] && queue+=("$kid")
    done
  done
  print -l -- $seen
}

# Bring every worker, and every ffmpeg under one, down; reap them; and only then
# judge what they were half-way through writing. Discarding a destination while
# its ffmpeg is still alive would delete a file that is about to be rewritten.
stop_workers() {
  local name="$1"
  local -i num="$2" i
  local -a tree alive late partials
  local p f dest

  # Snapshotted before signalling: once a worker is gone its ffmpeg has been
  # reparented, and pgrep -P can no longer reach it from here.
  tree=(${(f)"$(worker_tree $WORKER_PIDS)"})
  kill -$num $tree 2>/dev/null

  # A worker only reaches its own trap once the ffmpeg it was blocked on has
  # exited, so give the tree a moment to come apart on its own.
  for (( i = 1; i <= 100; i++ )); do
    alive=()
    for p in $tree; do kill -0 $p 2>/dev/null && alive+=("$p"); done
    (( ${#alive} )) || break
    # A worker can have forked an ffmpeg in the moment between the snapshot and
    # the signal — on a loaded machine, easily. zsh then defers that worker's
    # trap until the ffmpeg returns, which for a 300-second encode is never, so
    # the worker sits there until the SIGKILL below. Rescanning every pass is
    # what stops that late child being orphaned by it.
    late=(${(f)"$(worker_tree $alive)"})
    for p in $late; do
      (( ${tree[(I)$p]} )) || tree+=("$p")
    done
    kill -$num $late 2>/dev/null
    sleep 0.05
  done
  # Anything still standing after five seconds is not going to stop politely.
  # Deepest first: SIGKILLing a worker ahead of its ffmpeg would hand that
  # ffmpeg to launchd, still writing into the file about to be discarded.
  if (( ${#alive} )); then
    alive=(${(f)"$(worker_tree $alive)"})
    kill -KILL ${(Oa)alive} 2>/dev/null
  fi

  for p in $WORKER_PIDS; do wait $p 2>/dev/null; done
  # One last look. Anything from the tree still breathing now that its worker
  # has been reaped is an orphan by definition, and would go on writing into a
  # destination the sweep below is about to discard.
  for p in $tree; do
    kill -0 $p 2>/dev/null && kill -KILL $p 2>/dev/null
  done
  WORKER_PIDS=()

  if [[ -n "$STATE_DIR" ]]; then
    for f in "$STATE_DIR"/inflight.*(N); do
      [[ -s "$f" ]] || continue
      dest="$(<"$f")"
      [[ -n "$dest" ]] || continue
      discard_output "$dest"
      log_line "INTERRUPTED ($name) discarded partial output $dest"
      partials+=("$dest")
      : > "$f"
    done
  fi

  if (( ${#partials} == 1 )); then
    print -u2 "decant: interrupted ($name) — discarded the partial ${partials[1]:t}"
  elif (( ${#partials} )); then
    print -u2 "decant: interrupted ($name) — discarded ${#partials} partial outputs"
  else
    print -u2 "decant: interrupted ($name)"
  fi
}

# zsh defers a trap until the foreground child returns, so this runs once the
# signalled ffmpeg is gone — after which the half-written file is safe to drop.
# Under --jobs there are N of those files and N children holding them open, so
# that case reaps first and cleans up second.
on_signal() {
  local name="$1" num="$2"
  if (( ${#WORKER_PIDS} )); then
    stop_workers "$name" "$num"
  elif [[ -n "$IN_FLIGHT_DEST" ]]; then
    discard_output "$IN_FLIGHT_DEST"
    log_line "INTERRUPTED ($name) discarded partial output $IN_FLIGHT_DEST"
    print -u2 "decant: interrupted ($name) — discarded the partial ${IN_FLIGHT_DEST:t}"
    IN_FLIGHT_DEST=""
  else
    print -u2 "decant: interrupted ($name)"
  fi
  exit $(( 128 + num ))
}
# Removing nothing is the normal case: a serial run never makes a scratch
# directory. This has to be armed here at the top level rather than where the
# directory is created, because zsh runs an EXIT trap set inside a function the
# moment that function returns — which would delete the directory before a
# single worker had written to it.
cleanup_state() {
  [[ -n "$STATE_DIR" ]] && rm -rf -- "$STATE_DIR" 2>/dev/null
  return 0
}

trap 'on_signal INT 2'   INT
trap 'on_signal TERM 15' TERM
trap 'on_signal HUP 1'   HUP
trap 'cleanup_state'     EXIT

# Sets CONVERT_ERR on total failure and ART_DROPPED when the art-preserving
# attempt fails but the audio-only fallback succeeds. Writes straight to "$out".
# ENC_EXTRA carries per-file encoder options (the MP3 bitrate cap); the tag
# chunk is ID3v2 in both containers — AIFF via its muxer flag, MP3 as v2.3 for
# widest player compatibility.
convert_file() {
  local src="$1" tgt="$2" out="$3" out_fmt="$4"
  CONVERT_ERR=""
  ART_DROPPED=0
  local -a inputs map tag_args map_meta
  inputs=(-i "$src")
  # Take the first audio stream plus the cover art, never `-map 0`: AIFF and MP3
  # hold exactly one audio stream, so a source carrying a second one (or a stray
  # data stream) is rejected by the muxer and never converts at all. The art is
  # matched as 0:v:0 rather than by attached_pic disposition because Matroska
  # carries real cover art without that flag set.
  map=(-map 0:a:0 -map '0:v:0?')
  if [[ "$out_fmt" == mp3 ]]; then
    tag_args=(-id3v2_version 3)
  else
    tag_args=(-write_id3v2 1)
  fi
  # Some containers (Ogg/Opus always; Matroska and others sometimes) keep tags
  # on the audio STREAM rather than the format, and probe_source treats those
  # exactly like format-level tags when deciding what already exists (see the
  # comment above probe_source: streams win over format there). So the copy
  # here has to reach the stream dictionary too, or a stream-only tag that
  # probe_source correctly saw as "present" — and therefore did not
  # derive a filename-based replacement for — never makes it into the output
  # at all. -map_metadata copies into the destination without overwriting a
  # key already set there (confirmed empirically: two calls targeting the
  # same global metadata are additive, and on a genuine key collision the
  # first call wins), so the stream mapping is listed first to give it the
  # same priority on write that it already has on read.
  map_meta=(-map_metadata 0:s:a:0 -map_metadata 0)
  # CDJs/rekordbox only render JPEG cover art in MP3s, so re-encode any other
  # image format into a baseline JPEG; already-JPEG art is copied bit-exact.
  # The source's own art format is whatever probe_source read off it.
  local -a art_args
  art_args=(-c:v copy)
  if [[ "$out_fmt" == mp3 ]]; then
    local art_fmt
    if [[ -n "$ART_INPUT" ]]; then
      art_fmt="${ART_INPUT:e:l}"
      [[ "$art_fmt" == (jpg|jpeg) ]] && art_fmt=mjpeg
    else
      art_fmt="$SRC_ART_CODEC"
    fi
    [[ -n "$art_fmt" && "$art_fmt" != mjpeg ]] && art_args=(-c:v mjpeg -q:v 2 -pix_fmt:v yuvj420p)
  fi
  # Embed album-folder art (set by build_meta_args) only when the source has
  # none of its own.
  if [[ -n "$ART_INPUT" ]]; then
    inputs+=(-i "$ART_INPUT")
    map+=(-map 1:v -disposition:v attached_pic)
  fi
  # First attempt keeps the audio and the embedded/folder cover art, and applies
  # the enrichment -metadata after -map_metadata so it overrides/adds.
  if ffmpeg -nostdin -hide_banner -loglevel error -y \
        "${inputs[@]}" "${map[@]}" "${map_meta[@]}" "${META_ARGS[@]}" \
        -c:a "$tgt" "${ENC_EXTRA[@]}" "${art_args[@]}" "${tag_args[@]}" -f "$out_fmt" "$out" 2>/dev/null; then
    return 0
  fi
  # Fallback: audio + metadata only (drops art the muxer rejected).
  local err
  err=$(ffmpeg -nostdin -hide_banner -loglevel error -y \
        -i "$src" -map 0:a:0 "${map_meta[@]}" "${META_ARGS[@]}" \
        -c:a "$tgt" "${ENC_EXTRA[@]}" "${tag_args[@]}" -f "$out_fmt" "$out" 2>&1) && { ART_DROPPED=1; return 0; }
  CONVERT_ERR="${err//$'\n'/ | }"
  return 1
}

process_file() {
  local src="$1"
  local ext="${src:e:l}"

  # Only consider files with a recognised audio extension. This is a safety net:
  # without it ffmpeg will happily mis-detect unrelated files (e.g. a `.al` text
  # file as raw A-law audio) and "convert" them. Extension gate first, codec
  # check second.
  is_audio_ext "$ext" || return

  # Empty file → skip (treat like a non-audio file, never a failure).
  [[ -s "$src" ]] || return

  probe_source "$src"
  local codec="$SRC_CODEC"

  # No audio stream → not an audio file. Do nothing.
  [[ -z "$codec" ]] && return

  if [[ "$ext" == (aiff|aif|aifc) && "$codec" == pcm_* ]]; then
    log_debug "SKIP (already aiff) $src"
    (( skipped++ )); return
  fi

  # Lossless sources become AIFF (bit-exact). Lossy .m4a/.opus become MP3 at
  # a bitrate capped to the source's. DSD is lossless but has no bit-exact PCM
  # target, so it is declined under its own name. Other lossy codecs are left
  # untouched.
  local out_fmt
  if is_lossless "$codec"; then
    out_fmt=aiff
  elif is_dsd "$codec"; then
    log_debug "SKIP (DSD, no bit-exact PCM conversion: $codec) $src"
    (( skipped++ )); return
  elif [[ "$ext" == opus || ( "$ext" == m4a && "$codec" == aac ) ]]; then
    out_fmt=mp3
  else
    log_debug "SKIP (lossy/unsupported: $codec) $src"
    (( skipped++ )); return
  fi

  # Truncated/corrupt file: ffprobe guessed the codec from the extension but
  # cannot determine a sample format. Skip rather than fail the whole run.
  if [[ -z "$SRC_FMT" || "$SRC_FMT" == "unknown" ]]; then
    log_debug "SKIP (unreadable audio) $src"
    (( skipped++ )); return
  fi

  local dest="${src:r}.$out_fmt"
  if [[ -e "$dest" && "${dest:A}" != "${src:A}" ]]; then
    if [[ -d "$dest" ]]; then
      # Never treat a directory as debris — discarding it would trash the folder
      # and everything in it.
      print -u2 "decant: FAILED ${src:t} — ${dest:t} exists and is a directory"
      log_line "FAILED $src :: target exists as a directory: $dest"
      (( failed++ )); return
    elif [[ -s "$dest" ]] && valid_audio "$dest"; then
      print -u2 "decant: skip ${src:t} — ${dest:t} already exists"
      log_debug "SKIP (target exists) $src"
      (( skipped++ )); return
    fi
    # Empty or unreadable: debris from a run that died mid-encode. Skipping it
    # would strand this source forever, silently and without explanation.
    print -u2 "decant: ${dest:t} exists but is not valid audio — treating it as debris from an interrupted run"
    log_line "RECOVER (unusable target) $src -> $dest"
  fi

  local tgt label
  ENC_EXTRA=()
  if [[ "$out_fmt" == aiff ]]; then
    target_codec "$SRC_BITS" "$SRC_FMT"; tgt="$REPLY"
    label="$tgt"
  else
    tgt=libmp3lame
    # Chaining through REPLY is safe because an argument is expanded before the
    # function it is passed to runs, so mp3_bitrate_for reads the measured rate
    # before overwriting it with its own answer.
    local kbps; source_bitrate "$src"; mp3_bitrate_for "$REPLY"; kbps="$REPLY"
    # -compression_level 0 = LAME's best-quality (slowest) algorithm at the
    # chosen CBR rate.
    ENC_EXTRA=(-b:a "${kbps}k" -compression_level 0)
    # CDJs only play MPEG-1 Layer III rates, so an off-spec source rate has to
    # be resampled. Empty for a source already on a supported rate — the AIFF
    # path never resamples at all.
    cdj_resample_args "$SRC_RATE"
    ENC_EXTRA+=("${RESAMPLE_ARGS[@]}")
    label="mp3 ${kbps}k"
  fi

  # Compute the fill-gaps-only enrichment plan (catalog→grouping, track/disc,
  # feat→ft, folder art) from the tags and art the source probe already read.
  # Skipped entirely under --no-enrich / DECANT_NO_ENRICH (pure transcode).
  META_ARGS=(); META_PLAN=(); ART_INPUT=""
  if (( ENRICH )); then
    build_meta_args "$src" "$SRC_TRACK" "$SRC_DISC" "$SRC_GROUPING" "$SRC_TITLE" "$SRC_HAS_ART"
  fi

  if (( DRYRUN )); then
    if (( ${#META_PLAN} )); then
      print -u2 -- "decant: would convert ${src:t} ($label) [${(j: :)META_PLAN}]"
    else
      print -u2 -- "decant: would convert ${src:t} ($label)"
    fi
    (( previewed++ )); return
  fi

  # ffmpeg writes the output DIRECTLY to its final path — no temp file, no rename.
  # A sandboxed Finder Quick Action (run by ShortcutsMacHelper) lets ffmpeg
  # CREATE files even inside TCC-protected folders, but the shell may NOT
  # rename/delete a file a child process (ffmpeg) created — which is why the
  # old "ffmpeg → temp, shell mv → dest" approach failed in Downloads/Desktop/
  # Documents. The original is trashed only after the output is verified valid.
  set_inflight "$dest"
  if convert_file "$src" "$tgt" "$dest" "$out_fmt" && [[ -s "$dest" ]] && valid_audio "$dest"; then
    set_inflight ""
    local trashed=1
    trash_original "$src" || trashed=0
    print -u2 -- "decant: converted ${src:t} → ${dest:t} ($label)"
    if (( ! trashed )); then
      # The conversion still succeeded; the user just has both files now.
      print -u2 "decant: warning: could not move ${src:t} to the Trash — the original is still there"
      log_line "TRASH FAILED $src (original left in place)"
    fi
    if (( ART_DROPPED )); then
      print -u2 "decant: note: dropped unembeddable artwork for ${src:t}"
      log_debug "CONVERTED (artwork dropped) $src -> $dest [$label]"
    else
      log_debug "CONVERTED $src -> $dest [$label]"
    fi
    (( converted++ ))
  else
    discard_output "$dest"
    set_inflight ""
    print -u2 "decant: FAILED ${src:t}"
    log_line "FAILED $src [$tgt] :: ${CONVERT_ERR:-unknown error}"
    (( failed++ ))
  fi
}

# Per-run scratch for the workers' in-flight destinations and their tallies.
# Created only when --jobs actually asks for workers, so a serial run makes
# nothing and has nothing to clean up.
ensure_state_dir() {
  [[ -n "$STATE_DIR" ]] && return 0
  STATE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/decant.XXXXXX" 2>/dev/null) || { STATE_DIR=""; return 1 }
  return 0
}

# One worker's share of a batch. It re-reads the shared file list rather than
# being handed a slice of it: zsh has no nested arrays, and the fork has already
# given this process a private copy of everything the parent had.
worker_main() {
  local -i id=$1 i
  # A worker has no workers of its own. Without this it would inherit the PIDs of
  # the siblings forked before it and try to stop them on a signal.
  WORKER_PIDS=()
  INFLIGHT_FILE="$STATE_DIR/inflight.$id"
  : > "$INFLIGHT_FILE"
  trap 'worker_signal' INT TERM HUP
  # The fork carried the parent's running totals in with it. Report only this
  # worker's own share; the parent adds the stripes back together.
  converted=0 skipped=0 failed=0 previewed=0
  for (( i = 1; i <= ${#BATCH_FILES}; i++ )); do
    (( BATCH_ASSIGN[i] == id )) || continue
    process_file "${BATCH_FILES[i]}"
  done
  print -r -- "$converted $skipped $failed $previewed" > "$STATE_DIR/counts.$id"
}

# Stripe a batch across JOBS workers, then add up what they each did.
run_batch_parallel() {
  BATCH_FILES=("$@")
  BATCH_ASSIGN=()

  local -A stem_worker
  local key p
  local -a tally
  local -i i nf=${#BATCH_FILES} next=0 w nworkers=$JOBS
  (( nworkers > nf )) && nworkers=$nf

  # Two sources in one folder can target the same output — track.flac and
  # track.wav both make track.aiff. Serial order resolved that: the first
  # converts, the second finds a valid destination sitting there and skips it.
  # Keeping such a pair on ONE worker, in snapshot order, is what makes that
  # still happen; racing them would put two ffmpegs on one path and trash both
  # originals. The key is lowercased because macOS filesystems are
  # case-insensitive by default, where Track.wav and track.flac really do collide.
  for (( i = 1; i <= nf; i++ )); do
    key="${${BATCH_FILES[i]:r}:l}"
    if (( ${+stem_worker[$key]} )); then
      w=$stem_worker[$key]
    else
      w=$(( next % nworkers + 1 ))
      (( next++ ))
      stem_worker[$key]=$w
    fi
    BATCH_ASSIGN[i]=$w
  done

  # Rotate here rather than from inside a worker: N workers each checking the
  # size for themselves would race, and the loser would rename away a log the
  # winner had already started writing this run's lines into.
  (( LOG_ROTATE_CHECKED )) || rotate_log

  WORKER_PIDS=()
  for (( w = 1; w <= nworkers; w++ )); do
    worker_main $w &
    WORKER_PIDS+=($!)
  done
  for p in $WORKER_PIDS; do wait $p 2>/dev/null; done
  WORKER_PIDS=()

  for (( w = 1; w <= nworkers; w++ )); do
    if [[ -s "$STATE_DIR/counts.$w" ]]; then
      tally=(${=$(<"$STATE_DIR/counts.$w")})
      (( converted += tally[1], skipped += tally[2], failed += tally[3], previewed += tally[4] ))
    else
      # A worker that died without reporting took its share of the tally with it.
      # Counting that as a failure is the only honest answer available: the run
      # must not exit 0 for files whose outcome nobody recorded.
      print -u2 "decant: FAILED a worker exited without reporting its results"
      log_line "FAILED worker $w of $nworkers exited without reporting"
      (( failed++ ))
    fi
    rm -f -- "$STATE_DIR/counts.$w" 2>/dev/null
  done

  BATCH_FILES=(); BATCH_ASSIGN=()
}

# Convert one snapshot of files. Serial is the default and is deliberately the
# same loop it has always been, down to the order of the lines it prints; --jobs
# stripes the same list across workers instead. A scratch directory that cannot
# be made is a reason to run serially, never a reason to fail the run.
run_batch() {
  local -a files=("$@")
  (( ${#files} )) || return 0
  if (( JOBS > 1 )) && ensure_state_dir; then
    run_batch_parallel "${files[@]}"
    return 0
  fi
  local f
  for f in "${files[@]}"; do
    process_file "$f"
  done
}

# Plain-file arguments pile up here so a run over several of them converts as one
# batch, and are flushed at every point where output order would otherwise
# change — before a folder is walked, and before any path-level message — so the
# lines still come out in the order the paths were given.
flush_pending() {
  (( ${#PENDING_FILES} )) || return 0
  local -a batch=("${PENDING_FILES[@]}")
  PENDING_FILES=()
  run_batch "${batch[@]}"
}

# Recursing one of these would scan an enormous tree and trash audio all over
# the system. Refuse them outright — a real target is always a specific file or
# album folder, never a filesystem root or a whole home/library directory.
is_forbidden_root() {
  local abs="${1:A}"
  case "$abs" in
    / | "$HOME" | /Users | /System | /Library | /Applications \
      | /usr | /sbin | /bin | /etc | /var | /private | /opt | /cores | /Volumes) return 0 ;;
    /System/* | /usr/*) return 0 ;;
  esac
  return 1
}

process_path() {
  local p="$1"
  # The output path is derived from the input, and ffmpeg has no way to be told
  # that an *output* starting with a dash is a filename rather than an option.
  # Anchoring to the cwd here is what makes `decant -- -foo.flac` convertible.
  [[ "$p" == -* ]] && p="./$p"
  if is_forbidden_root "$p"; then
    flush_pending
    print -u2 "decant: refusing to recurse '$p' (too broad — point me at a file or an album folder)"
    log_line "REFUSED (forbidden root) $p"
    (( refused++ )); return
  fi
  if [[ -d "$p" ]]; then
    flush_pending
    # Snapshot the tree before converting any of it. Streaming find(1) straight
    # into the loop let an output written moments ago be handed back by the same
    # find; collecting first also gives --jobs the whole list to stripe. -print0
    # because these names hold spaces, quotes, newlines and unicode.
    local -a files
    local file
    while IFS= read -r -d '' file; do
      files+=("$file")
    done < <(find "$p" -type f -print0)
    run_batch "${files[@]}"
  elif [[ -f "$p" ]]; then
    PENDING_FILES+=("$p")
  else
    flush_pending
    print -u2 "decant: not found: $p"
    log_line "MISSING $p"
    (( missing++ ))
  fi
}

# Non-destructive diagnostic: `decant --check-root PATH` exits 0 if PATH is a
# forbidden (too-broad) root, 2 if it would be processed. Used by the tests to
# verify the guard without ever scanning a real root.
if [[ "${1:-}" == "--check-root" ]]; then
  is_forbidden_root "${2:-}" && exit 0 || exit 2
fi

# Hidden dispatches so the pure enrichment parsers and the two gates that decide
# what gets converted can be unit-tested without an ffmpeg run (mirrors
# --check-root). ffmpeg decodes but cannot encode Shorten or DSD, so there is no
# way to generate a fixture for them — this is the only way to test their class.
# --resample-args is the exception that still shells out to ffmpeg, and that is
# the point: it reports what this build would genuinely be told to resample with.
case "${1:-}" in
  --detect-catalog)    detect_catalog "${2:-}" && print -r -- "$REPLY"; exit 0 ;;
  --derive-track-disc) derive_track_disc "${2:-}" && print -r -- "$REPLY"; exit 0 ;;
  --normalize-feat)    normalize_feat "${2:-}"; print -r -- "$REPLY"; exit 0 ;;
  --mp3-bitrate)       mp3_bitrate_for "${2:-}"; print -r -- "$REPLY"; exit 0 ;;
  --is-audio-ext)      is_audio_ext "${2:-}" && exit 0 || exit 2 ;;
  --classify-codec)
    if   is_lossless "${2:-}"; then print -r -- lossless
    elif is_dsd "${2:-}";      then print -r -- dsd
    else                            print -r -- lossy
    fi
    exit 0 ;;
  --folder-art)        find_folder_art "${2:-}" && print -r -- "$REPLY"; exit 0 ;;
  --resample-args)     cdj_resample_args "${2:-}"; print -r -- "${RESAMPLE_ARGS[*]}"; exit 0 ;;
esac

# The machine's logical core count, for --jobs auto. Falls back rather than
# failing: a wrong guess here costs throughput, never correctness.
_cpu_count() {
  local n
  n=$(sysctl -n hw.ncpu 2>/dev/null)
  [[ "$n" == <-> ]] && (( n >= 1 )) && { print -r -- "$n"; return }
  n=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
  [[ "$n" == <-> ]] && (( n >= 1 )) && { print -r -- "$n"; return }
  print -r -- 1
}

# Turn a --jobs/DECANT_JOBS value into a worker count, or refuse it outright.
# Anything that is neither 'auto' nor a positive whole number is a usage error
# rather than something to coerce: reading "8x" as 8 would parallelise a run
# nobody asked to parallelise, and reading it as 0 would fork no workers at all.
# Only a plain digit string counts as a number, for the same reason
# mp3_bitrate_for insists on one — zsh arithmetic expands a bare word as a
# variable name and keeps expanding it.
jobs_usage_error() {
    print -u2 -- "decant: --jobs needs a positive whole number, or 'auto': $1"
    print -u2 -- "       try 'decant --help' for usage"
    exit 64
}

resolve_jobs() {
  local want="$1"
  local -i n over=0
  if [[ "$want" == auto ]]; then
    n=$(_cpu_count)
  elif [[ "$want" == <-> ]]; then
    # Six digits is already absurd, and a value long enough to overflow zsh's
    # integers would wrap round to something that looks perfectly reasonable —
    # so the digit count is judged before the string reaches any arithmetic.
    if (( ${#want} > 6 )); then over=1; else n=$want; fi
    (( over || n >= 1 )) || jobs_usage_error "$want"
  else
    jobs_usage_error "$want"
  fi
  # A four-digit --jobs is a typo, not a plan: cap it rather than forking a
  # thousand ffmpegs at a machine that has a dozen cores.
  if (( over || n > JOBS_MAX )); then
    print -u2 -- "decant: --jobs $want is above the $JOBS_MAX-worker ceiling — using $JOBS_MAX"
    n=$JOBS_MAX
  fi
  JOBS=$n
}

# The flag wins over the variable, so the two can never disagree — the same
# single-source-of-truth rule --keep follows for DECANT_KEEP_ORIGINALS. An
# explicitly empty --jobs "" is a usage error, not a request for the default,
# which is why the flag being given is tracked apart from its value.
if (( JOBS_GIVEN )); then
  resolve_jobs "$JOBS_REQUEST"
elif [[ -n "${DECANT_JOBS:-}" ]]; then
  resolve_jobs "$DECANT_JOBS"
fi

ensure_tools

# As a Finder Quick Action, the "Run Shell Script" action captures whatever the
# script writes to stdout/stderr and materialises a non-empty stream as a stray
# stdout.txt / stderr.txt next to the files. That context is the only caller
# that passes --notify and never has a terminal attached, so discard both
# streams there — feedback comes from the notification and the central log
# instead. A real terminal (interactive --notify) keeps its output.
if (( NOTIFY )) && [[ ! -t 2 ]]; then
  exec >/dev/null 2>&1
fi

log_debug "RUN start: $*"

for arg in "${TARGETS[@]}"; do
  process_path "$arg"
done
flush_pending

if (( DRYRUN )); then
  print -u2 -- "decant: dry run — ${previewed} file(s) would convert, nothing changed"
  run_status; exit $?
fi

# Human-readable summary goes to stderr (discarded entirely in the Quick Action
# context above, where it would otherwise be captured to a stray file). The log
# keeps the full triple for debugging; the notification stays concise.
print -u2 -- "decant: $(summary_line)"
log_debug "RUN done: ${converted} converted, ${skipped} skipped, ${failed} failed"

(( NOTIFY )) && notify "$(summary_line)"

run_status
